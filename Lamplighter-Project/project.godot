ally="gruppo generico per gli alleati"
neutral_npc="gruppo generico per gli npc neutrali"
highlighter="gruppo per elementi che evidenziano"
highlightable="gruppo per elementi evidenziabili"
controllers="gruppo generico per tutti i controller che possono servire "
renderer="gruppo generico per i renderer"
targetable="gruppo per i nodi targetable"
walkable="gruppo generico per zone \"camminabili\" per l'algoritmo di navigazione"
bindable="gruppo generico per i nodi \"bindabili\""
navigationMesh="gruppo per le mesh da prendere in considerazione dal navigation region3D"

